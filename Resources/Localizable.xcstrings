      }
    },
    "例如：「上個月跟客戶談過哪些價格？」「寄信的機制最後怎麼決定的？」拾音會先找出相關的會議片段，再請整理工具回答，回答附上是哪一場會議、哪個時間點。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: “What prices did we discuss with clients last month?” or “What did we decide about sending email?” Shiyin first finds the relevant parts of your meetings, then asks the summarizer. Answers show which meeting and what time each point comes from."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：“上个月跟客户谈过哪些价格？”“寄信的机制最后怎么决定的？”拾音会先找出相关的会议片段，再请整理工具回答，回答附上是哪一场会议、哪个时间点。"
          }
        }
      }
    },
    "例如：「誰負責寄信的部分？」「最後決定的上線日期是哪一天？」回答只根據這場會議的會議紀錄和逐字稿，每一點都附上時間，點了就能聽原話。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: “Who's handling the email part?” or “What launch date did we settle on?” Answers use only this meeting's notes and transcript, and every point has a time you can click to hear what was said."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：“谁负责寄信的部分？”“最后决定的上线日期是哪一天？”回答只根据这场会议的会议记录和逐字稿，每一点都附上时间，点了就能听原话。"
          }
        }
      }
    },
    "例如：小明": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: Alex"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：小明"
          }
        }
      }
    },
    "依各檔案的檔名或修改日期": {
      "extractionState": "manual",
      "localizations": {
