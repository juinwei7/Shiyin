        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风没有送出声音，正在重新连接…"
          }
        }
      }
    },
    "麥克風沒有送出聲音，重新連接失敗：%@。會繼續重試，錄音沒有停": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
