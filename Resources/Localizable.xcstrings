    "「%@」不是 UTF-8 的文字檔。請另存成 UTF-8 再加入。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” isn't a UTF-8 text file. Save it as UTF-8 and add it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是 UTF-8 的文本文件。请另存成 UTF-8 再加入。"
