          "stringUnit": {
            "state": "translated",
            "value": "第一次使用下载模型时需要（约 1.7 GB）；整理会议记录时需要。录音、转录不需要"
          }
        }
      }
    },
    "第一次錄音時會詢問；被拒絕的話到「系統設定 → 隱私權與安全性 → 麥克風」打開拾音": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be asked the first time you record. If denied, turn on Shiyin in System Settings → Privacy & Security → Microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次录音时会询问；被拒绝的话到“系统设置 → 隐私与安全性 → 麦克风”打开拾音"
          }
        }
      }
    },
