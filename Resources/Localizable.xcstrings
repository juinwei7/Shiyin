            "state": "translated",
            "value": "Shiyin System Audio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾音系统声音"
          }
        }
      }
    },
    "拾音認出這個人的聲音，自動帶入名字。不對的話點名字": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiyin recognized this person's voice and filled in the name. Click the name if it's wrong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾音认出这个人的声音，自动带入名字。不对的话点名字"
          }
        }
      }
    },
    "拾音讀不了 .%@ 檔。請先匯出成 PDF 再加入。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiyin can't read .%@ files. Export it as PDF and add that instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾音读不了 .%@ 文件。请先导出成 PDF 再加入。"
          }
        }
      }
    },
    "拾音讀不了 Keynote 檔。請先在 Keynote 匯出成 PDF 再加入。": {
