          }
        }
      }
    },
    "公司有拾音的企業伺服器時，填入公司給的網址、按「登入」，在打開的網頁用公司帳號登入。登入後錄音交給公司的伺服器轉錄，沒有 NVIDIA 顯示卡的電腦也很快；整理也可以用公司提供的模型。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your company runs a Shiyin enterprise server, enter the URL they gave you, click Sign In, and sign in with your company account on the page that opens. Recordings are then transcribed on the company's server — fast even without an NVIDIA graphics card — and summaries can use the company's model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公司有拾音的企业服务器时，填入公司给的网址、按“登录”，在打开的网页用公司账号登录。登录后录音交给公司的服务器转录，没有 NVIDIA 显卡的电脑也很快；整理也可以用公司提供的模型。"
          }
        }
      }
    },
    "公司的企業伺服器關掉了這個功能。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your company's Shiyin server has turned this off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公司的企业服务器关掉了这个功能。"
          }
        }
      }
    },
    "公司的伺服器": {
      "extractionState": "manual",
