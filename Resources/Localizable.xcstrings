    },
    "%@ 還沒登入，登入之後才會用它整理。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t signed in. Shiyin will use it once you sign in."
