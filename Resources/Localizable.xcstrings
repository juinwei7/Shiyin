      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compress recordings to m4a after transcription (about 10–30 MB per hour)"
          }
        }
      }
    },
    "轉錄完成後檢查可能聽錯的字": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for misheard words after transcription"
          }
        }
      }
    },
    "轉錄完成後自動整理成會議紀錄": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarize automatically after transcription"
          }
        }
      }
    },
    "轉錄完成後，逐字稿會出現在這裡。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript will appear here after transcription."
          }
        }
      }
    },
    "轉錄完會自動整理。「紀錄」分頁由上而下是摘要、決議、待辦、未決問題和依議題分段的討論；每一條後面的時間點點一下，就從錄音那裡開始播放。右上角的範本選單可以換成一對一、訪談、課堂／演講、腦力激盪等格式，換完從「更多 → 重新處理」選「重新整理會議紀錄」。想找某件事，可以在「提問」分頁直接問，例如「預算最後決定多少？」，回答會附上時間點；工具列的「提問」可以一次問所有會議。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes are generated automatically after transcription. The Notes tab runs top to bottom: summary, decisions, action items, open questions, then the discussion by topic; click the timestamp after any line to play the recording from there. The template menu at the top right switches to formats such as one-on-one, interview, lecture or brainstorming; after changing it, choose More → Reprocess → Regenerate Notes. To find something, ask directly on the Ask tab, for example “What was the final budget?”; answers include timestamps. The Ask button in the toolbar searches every meeting at once."
          }
        }
      }
    },
    "轉錄時辨識說話者": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify speakers when transcribing"
          }
        }
      }
    },
