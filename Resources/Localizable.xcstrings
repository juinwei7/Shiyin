      }
    },
    "會參考詞彙表，中英夾雜、專有名詞比較準；聯發科開源的台灣模型，需要下載約 1.7 GB。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your glossary, so mixed Chinese-English and proper nouns come out better; MediaTek's open-source Taiwanese model, about 1.7 GB to download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会参考词汇表，中英夹杂、专有名词比较准；联发科开源的台湾模型，需要下载约 1.7 GB。"
          }
        }
      }
    },
    "會參考詞彙表，多人會議的漏字和同音字比 Breeze 少、速度快三成；阿里巴巴開源的模型，全程在這台 Mac 上跑、不連網，輸出會轉成台灣繁體；需要下載約 2.5 GB 的模型。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your glossary; drops fewer words in multi-speaker meetings and confuses fewer homophones than Breeze, about 30% faster. An open-source model from Alibaba that runs entirely on this Mac with no network access; Chinese output is converted to Taiwanese Traditional. Requires a 2.5 GB model download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会参考词汇表，多人会议的漏字和同音字比 Breeze 少、速度快三成；阿里巴巴开源的模型，全程在这台 Mac 上跑、不连网，输出会转成台湾繁体；需要下载约 2.5 GB 的模型。"
          }
        }
      }
    },
    "會打開 %@ 的登入頁，用公司帳號登入。登入後錄音交給公司的伺服器轉錄，整理也用公司設定的模型。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This opens the sign-in page at %@. Sign in with your company account; recordings are then transcribed on your company's server and summarized with your company's model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会打开 %@ 的登录页，用公司账号登录。登录后录音交给公司的服务器转录，整理也用公司设置的模型。"
          }
        }
      }
    },
    "會議": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议"
          }
        }
      }
    },
    "會議.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting.%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议.%@"
          }
        }
      }
    },
    "會議中一起討論的文件（簡報、規格書、報價單…）。整理會議紀錄、提問時會一起參考；也可以把文件拖進視窗": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents discussed in the meeting (slides, specs, quotes…). Used when writing notes and answering questions. You can also drag documents into the window"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议中一起讨论的文档（演示文稿、规格书、报价单…）。整理会议记录、提问时会一起参考；也可以把文档拖进窗口"
          }
        }
      }
    },
    "會議中一起討論的文件（簡報、規格書、報價單、白板照片）可以加進會議：會議標題下迴紋針圖示的選單（還沒有文件時寫「加入文件」）選「加入文件…」，或把 PDF、Word、PowerPoint、圖片拖進視窗。純文字、Markdown 要從「加入文件…」選（拖進來的 txt 會當成逐字稿、md 會當成筆記）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents discussed in a meeting (slides, specs, quotes, whiteboard photos) can be added to it: in the paperclip menu below the meeting title (“Add Documents” when there are none yet), choose “Add Documents…”, or drag PDF, Word, PowerPoint, or image files into the window. Plain text and Markdown files have to be chosen with “Add Documents…” (a dragged txt file becomes a transcript, an md file becomes notes)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议中一起讨论的文档（演示文稿、规格书、报价单、白板照片）可以加进会议：会议标题下回纹针图标的菜单（还没有文档时写“加入文档”）选“加入文档…”，或把 PDF、Word、PowerPoint、图片拖进窗口。纯文本、Markdown 要从“加入文档…”选（拖进来的 txt 会当成逐字稿、md 会当成笔记）。"
          }
        }
      }
    },
    "會議內容的文字大小": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting text size"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议内容的文字大小"
          }
        }
      }
    },
    "會議可以分資料夾：在會議上按右鍵（或「更多」）選「移到資料夾」→「新資料夾…」。側欄上方的「資料夾」可以切換只看某個資料夾；正在看某個資料夾時，新錄的和匯入的會議都會放進去。資料夾按右鍵可以重新命名或刪除（會議會保留）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize meetings in folders: right-click a meeting (or use “More”) and choose “Move to Folder” → “New Folder…”. Use “Folders” at the top of the sidebar to show one folder; while you're in a folder, new recordings and imports go into it. Right-click a folder to rename or delete it (its meetings are kept)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议可以分文件夹：在会议上按右键（或“更多”）选“移到文件夹”→“新文件夹…”。侧边栏上方的“文件夹”可以切换只看某个文件夹；正在看某个文件夹时，新录的和导入的会议都会放进去。文件夹按右键可以重新命名或删除（会议会保留）。"
          }
        }
      }
    },
