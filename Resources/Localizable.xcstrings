    "轉錄完成後自動整理成會議紀錄": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarize automatically after transcription"
          }
        },
        "zh-Hans": {
