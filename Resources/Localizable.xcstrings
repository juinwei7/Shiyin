          }
        }
      }
    },
    "登入成功之後，才會登出目前的「%@」（%@）；沒有登入成功就維持原本的登入。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be signed out of %@ (%@) only after signing in here succeeds. If it doesn't, you stay signed in as before."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录成功之后，才会退出登录目前的“%@”（%@）；没有登录成功就维持原本的登录。"
          }
        }
      }
    },
