    "%@失敗（錯誤代碼 %d）。請確認已允許拾音「錄製系統音訊」": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ failed (error %d). Make sure Shiyin is allowed to record system audio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@失败（错误代码 %d）。请确认已允许拾音“录制系统音频”"
          }
        }
      }
    },
    "%@會議一律用 Qwen3-ASR。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ meetings always use Qwen3-ASR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@会议一律用 Qwen3-ASR。"
          }
        }
      }
    },
    "%@會議改用 Whisper large-v3-turbo（574 MB）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ meetings use Whisper large-v3-turbo (574 MB) instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@会议改用 Whisper large-v3-turbo（574 MB）。"
          }
        }
      }
    },
    "%@會議用，574 MB。第一次轉錄這些語言的會議時會自動下載。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for %@ meetings, 574 MB. Downloaded automatically the first time a meeting in one of these languages is transcribed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@会议用，574 MB。第一次转录这些语言的会议时会自动下载。"
          }
        }
      }
    },
