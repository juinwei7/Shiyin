          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公司的服务器还没有提供整理用的模型：请管理者在服务器后台的“整理模型”加上模型。"
          }
        }
      }
    },
    "公司的伺服器還沒登入或登入已失效，請到設定 → 進階 → 企業伺服器登入": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
