      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Company server"
          }
        }
      }
    },
    "公司的伺服器還沒有提供整理用的模型，請通知管理者": {
      "extractionState": "manual",
      "localizations": {
