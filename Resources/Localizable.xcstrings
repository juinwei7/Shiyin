    "錄下來：現場會議或線上會議，錄音時就有即時逐字稿。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record: in-person or online meetings, with a live transcript while recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录下来：现场会议或线上会议，录音时就有实时逐字稿。"
          }
        }
      }
    },
    "錄現場會議或你自己的聲音。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record in-person meetings or your own voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录现场会议或你自己的声音。"
          }
        }
      }
    },
    "錄線上會議對方的聲音用。第一次選「麥克風＋電腦聲音」錄音時 macOS 會詢問，按允許就好。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures the other side of online meetings. The first time you record with “Microphone + computer audio”, macOS will ask; just allow it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录线上会议对方的声音用。第一次选“麦克风＋电脑声音”录音时 macOS 会询问，按允许就好。"
          }
        }
      }
    },
    "錄線上會議時選「麥克風＋電腦聲音」：你的聲音和對方的聲音會分別錄在左右聲道。第一次錄電腦聲音時，macOS 會詢問「錄製系統音訊」的權限。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For online meetings, choose “Microphone + computer audio”: your voice and the other side are recorded on the left and right channels. The first time you record computer audio, macOS asks for System Audio Recording permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录线上会议时选“麦克风＋电脑声音”：你的声音和对方的声音会分别录在左右声道。第一次录电脑声音时，macOS 会询问“录制系统音频”的权限。"
          }
        }
      }
    },
    "錄製系統音訊": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Audio Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制系统音频"
          }
        }
      }
    },
    "錄音": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音"
          }
        }
      }
    },
    "錄音 %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音 %@"
          }
        }
      }
    },
    "錄音、逐字稿和會議紀錄都只存在這台 Mac 上（~/Library/Application Support/Shiyin），不會被 iCloud 同步。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings, transcripts and meeting notes are stored only on this Mac (~/Library/Application Support/Shiyin) and aren't synced to iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音、逐字稿和会议记录都只存在这台 Mac 上（~/Library/Application Support/Shiyin），不会被 iCloud 同步。"
          }
        }
      }
    },
    "錄音一直沒辦法完整傳到企業伺服器": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording couldn't be uploaded to the enterprise server completely"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音一直没办法完整传到企业服务器"
          }
        }
      }
    },
    "錄音不會中斷，接著用這支麥克風錄；之後的錄音也用這支": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording continues with this microphone; new recordings will use it too"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音不会中断，接着用这个麦克风录；之后的录音也用这个"
          }
        }
      }
    },
    "錄音中": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中"
          }
        }
      }
    },
    "錄音中 15 分鐘沒人說話時提醒你；再 15 分鐘還是沒人說話就自動停止，只轉錄到最後有人說話的地方，錄音檔完整保留。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiyin reminds you after 15 minutes with nobody talking. After 15 more minutes of silence it stops recording and transcribes only up to the last speech; the full recording is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中 15 分钟没人说话时提醒你；再 15 分钟还是没人说话就自动停止，只转录到最后有人说话的地方，录音文件完整保留。"
          }
        }
      }
    },
    "錄音中在其他 app 裡也能標記重點": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark while recording, even from another app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中在其他 app 里也能标记重点"
          }
        }
      }
    },
    "錄音中很久沒人說話，拾音自動停止了錄音。要轉錄全部的話，用「更多 → 重新處理 → 重新轉錄」。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody spoke for a long time, so Shiyin stopped recording. To transcribe everything, use More → Reprocess → Transcribe Again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中很久没人说话，拾音自动停止了录音。要转录全部的话，用“更多 → 重新处理 → 重新转录”。"
          }
        }
      }
    },
    "錄音中按 %@ 標記重點（在其他 app 裡也能用）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While recording, press %@ to mark a highlight (works in other apps too)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中按 %@ 标记重点（在其他 app 里也能用）"
          }
        }
      }
    },
    "錄音中標記重點": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark the moment while recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中标记重点"
          }
        }
      }
    },
    "錄音中畫面左邊是即時逐字稿，講完幾秒內就會出現；右邊「我的筆記」每換一行會自動記下當時的錄音時間（錄完在逐字稿分頁頂部的「我的筆記」還能改）。重要的地方按「標記重點」（⌘B），在其他 app 裡也可以按 ⌃⌥⌘B。需要中斷時按「暫停」（⇧⌘P），暫停的時間不會錄進去。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While recording, the live transcript appears on the left within seconds of speech; My notes on the right stamps the recording time on every new line (you can still edit them later under My notes at the top of the Transcript tab). Press Bookmark (⌘B) at important moments, or ⌃⌥⌘B from any app. Press Pause (⇧⌘P) to take a break; paused time is not recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中画面左边是实时逐字稿，讲完几秒内就会出现；右边“我的笔记”每换一行会自动记下当时的录音时间（录完在逐字稿标签页顶部的“我的笔记”还能改）。重要的地方按“标记重点”（⌘B），在其他 app 里也可以按 ⌃⌥⌘B。需要中断时按“暂停”（⇧⌘P），暂停的时间不会录进去。"
          }
        }
      }
    },
    "錄音中顯示即時逐字稿": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show live transcript while recording"
          }
        },
        "zh-Hans": {
