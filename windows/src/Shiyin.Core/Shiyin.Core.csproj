<Project Sdk="Microsoft.NET.Sdk">
  <!-- 不碰 Windows API 的邏輯：資料模型、提示詞、匯出、轉錄流程的規則（design-windows §1） -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shiyin</RootNamespace>
  </PropertyGroup>
  <!-- 簡轉繁的字表（M§32.5、D108）：跟 Mac 共用 Resources/opencc 的同一份檔案，內嵌在組件裡 -->
  <ItemGroup>
    <EmbeddedResource Include="../../../Resources/opencc/*.tsv" LogicalName="opencc/%(Filename)%(Extension)" />
    <!-- 語言檔（M§41.1、D139）：跟 Mac 共用同一份 -->
    <EmbeddedResource Include="../../../Resources/languages.json" LogicalName="languages.json" />
    <!-- 簡體介面的用語表（M§48.1、D155）：跟 Mac 共用同一份 -->
    <EmbeddedResource Include="../../../Resources/l10n/zh-Hans-terms.tsv" LogicalName="l10n/zh-Hans-terms.tsv" />
  </ItemGroup>
</Project>
