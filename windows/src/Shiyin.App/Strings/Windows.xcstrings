      }
    },
    "Qwen3-ASR 的轉錄程式（llama-server）出錯，請再試一次；一直失敗的話到設定改回 Breeze": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Qwen3-ASR transcription program (llama-server) failed. Try again; if it keeps failing, switch back to Breeze in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen3-ASR 的转录程序（llama-server）出错，请再试一次；一直失败的话到设置改回 Breeze"
          }
        }
      }
    },
    "WAV 缺少格式區段": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WAV file has no format chunk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WAV 缺少格式区段"
          }
        }
      }
    },
    "Windows 解不開 .%@ 的檔案：請先轉成 m4a、mp3 或 wav 再匯入（ogg、opus 可以從 Microsoft Store 安裝「Web 媒體延伸模組」）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows can’t decode .%@ files. Convert it to m4a, mp3, or wav and import again (for ogg and opus, install “Web Media Extensions” from the Microsoft Store)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 解不开 .%@ 的文件：请先转成 m4a、mp3 或 wav 再导入（ogg、opus 可以从 Microsoft Store 安装“Web 媒体延伸模组”）"
          }
        }
      }
    },
    "claude 沒有回傳結果（結束代碼 %lld）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "claude returned no result (exit code %lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "claude 没有返回结果（退出代码 %lld）"
          }
        }
      }
    },
    "codex 沒有回傳結果（結束代碼 %lld）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "codex returned no result (exit code %lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "codex 没有返回结果（退出代码 %lld）"
          }
        }
      }
    },
    "「%@」裡讀不到文字。這台電腦沒有%@的文字辨識：到「設定 → 時間與語言 → 語言與地區」加入%@再試。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text could be read from “%@”. This PC has no text recognition for %@: add %@ in Settings → Time & language → Language & region, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”里读不到文字。这台电脑没有%@的文字识别：到“设置 → 时间与语言 → 语言与地区”加入%@再试。"
          }
        }
      }
    },
    "「待確認」列出整理時沒把握的人名、專有名詞、負責人和期限。在「你的回答」欄位直接回答，按「送出」，會議紀錄就會依你的答案修正；看不懂或不重要的勾「略過」。也可以在「摘要」按「編輯」直接改。改錯了可以從「更多」選「復原上一版會議紀錄」。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“To confirm” lists names, terms, owners and deadlines the summarizer wasn't sure about. Type in “Your answer” and click “Submit”, and the notes are revised from your answers; check “Skip” for anything unclear or unimportant. You can also click “Edit” in “Summary” to change things directly. To undo a mistake, choose “Revert to previous notes” from “More”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“待确认”列出整理时没把握的人名、专有名词、负责人和期限。在“你的回答”字段直接回答，按“送出”，会议记录就会依你的答案修正；看不懂或不重要的勾“略过”。也可以在“摘要”按“编辑”直接改。改错了可以从“更多”选“恢复上一版会议记录”。"
          }
        }
      }
    },
    "「待確認」列出整理時沒把握的人名、專有名詞、負責人和期限。紀錄裡有疑問的那一條旁邊會有「？」，點了就能當場回答；也可以到「待確認」分頁一次看完。能用是或否回答的直接按「是」「不是」（按「是」不用等整理工具），其他的在「你的回答」欄位回答，按「送出」，會議紀錄就會依你的答案修正；看不懂或不重要的按「略過」，或一次「全部略過」。也可以在「摘要」按「編輯」直接改。改錯了可以從「更多」選「復原上一版會議紀錄」。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“To confirm” lists the names, terms, owners and deadlines the summarizer wasn’t sure about. The note in question gets a “?” next to it: click it to answer right there, or open the “To confirm” tab to go through them all. Questions that take yes or no have “Yes” and “No” buttons (“Yes” confirms on the spot, no waiting for the summarizer); answer the others in “Your answer”, then click “Submit” and the notes are revised to match. Click “Skip” on anything unclear or unimportant, or “Skip all”. You can also edit the notes directly with “Edit” on the Summary tab. If something goes wrong, choose “Restore previous notes” from “More”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“待确认”列出整理时没把握的人名、专有名词、负责人和期限。记录里有疑问的那一条旁边会有“？”，点了就能当场回答；也可以到“待确认”标签页一次看完。能用是或否回答的直接按“是”“不是”（按“是”不用等整理工具），其他的在“你的回答”字段回答，按“送出”，会议记录就会依你的答案修正；看不懂或不重要的按“略过”，或一次“全部略过”。也可以在“摘要”按“编辑”直接改。改错了可以从“更多”选“恢复上一版会议记录”。"
          }
        }
      }
    },
    "・匯入：把錄音檔拖進視窗，或按「匯入」（Ctrl+O）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Import: drag a recording into the window, or click Import (Ctrl+O)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "・导入：把录音文件拖进窗口，或按“导入”（Ctrl+O）"
          }
        }
      }
    },
    "・拾音會常駐在工作列右下角的系統匣，關掉視窗也會繼續錄音和整理。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Shiyin stays in the system tray at the bottom right of the taskbar; closing the window keeps recording and processing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "・拾音会常驻在工作列右下角的系统托盘，关掉窗口也会继续录音和整理。"
          }
        }
      }
    },
    "・錄音：側欄上方的「錄音」（Ctrl+R），或在其他 app 裡按 Ctrl+Alt+Shift+R": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Record: click Record at the top of the sidebar (Ctrl+R), or press Ctrl+Alt+Shift+R in any app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "・录音：侧边栏上方的“录音”（Ctrl+R），或在其他 app 里按 Ctrl+Alt+Shift+R"
          }
        }
      }
    },
    "下載的壓縮檔裡少了需要的檔案，請重新下載": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded archive is missing required files. Please download it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的压缩文件里少了需要的文件，请重新下载"
          }
        }
      }
    },
    "下載的檔案不完整": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download is incomplete"
