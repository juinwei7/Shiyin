      }
    },
    "全域快捷鍵 Ctrl+Alt+Shift+R：在其他 app 裡也能開始或停止錄音": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global shortcut Ctrl+Alt+Shift+R: start or stop recording from any app"
          }
