      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifying speakers on the enterprise server"
          }
        }
      }
    },
    "使用 %@ 附的 codex（這台電腦沒有另外安裝 Codex CLI）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the codex bundled with %@ (Codex CLI isn't installed separately on this PC)"
