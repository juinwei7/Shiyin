      }
    },
    "登入公司的企業伺服器時：錄音會上傳到公司自己的伺服器轉錄和辨識說話者，不經過其他雲端服務，轉完就刪，聲紋不存在伺服器；選「公司」整理時，逐字稿送到公司的伺服器，由公司選的模型整理（公司機房裡的模型，或公司接的 AI 服務）。公司的後台只看得到用量的數字（幾分鐘、幾次），看不到會議內容。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you’re signed in to your company’s enterprise server: recordings are uploaded to your company’s own server for transcription and speaker identification, without passing through any other cloud service, and deleted once transcribed; voiceprints aren’t kept on the server. With the “Company” summarizer, the transcript goes to your company’s server and is summarized by the model your company chose (one in its own data center, or an AI service it uses). The company’s admin console shows only usage numbers (minutes, counts), never meeting content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录公司的企业服务器时：录音会上传到公司自己的服务器转录和识别说话者，不经过其他云端服务，转完就删，声纹不存在服务器；选“公司”整理时，逐字稿送到公司的服务器，由公司选的模型整理（公司机房里的模型，或公司接的 AI 服务）。公司的后台只看得到用量的数字（几分钟、几次），看不到会议内容。"
          }
        }
      }
    },
    "目前不整理：錄音、轉錄、逐字稿全部留在這台電腦。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes are off: recordings, transcription and transcripts all stay on this PC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前不整理：录音、转录、逐字稿全部留在这台电脑。"
          }
        }
      }
    },
    "系統預設（%@）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System default (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统默认（%@）"
          }
        }
      }
    },
    "紀錄、逐字稿、提問、即時逐字稿和我的筆記的文字。也可以用 Ctrl+加號、Ctrl+減號調整，Ctrl+0 回到標準大小。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text in Notes, Transcript, Ask, the live transcript and My notes. You can also press Ctrl+Plus or Ctrl+Minus, and Ctrl+0 to return to the default size."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录、逐字稿、提问、实时逐字稿和我的笔记的文字。也可以用 Ctrl+加号、Ctrl+减号调整，Ctrl+0 回到标准大小。"
          }
        }
      }
    },
    "繼續錄音（Ctrl+Shift+P）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume recording (Ctrl+Shift+P)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续录音（Ctrl+Shift+P）"
          }
        }
      }
    },
    "聲紋（說話者的聲音特徵，一組數字，不是錄音）只存在這台電腦，不會放進匯出的 .shiyin 封包。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voiceprints (a speaker's voice features: a list of numbers, not audio) stay on this PC and are never included in exported .shiyin packages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声纹（说话者的声音特征，一组数字，不是录音）只存在这台电脑，不会放进导出的 .shiyin 文件包。"
          }
        }
      }
    },
    "複製會議紀錄：Markdown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Notes: Markdown"
          }
        },
