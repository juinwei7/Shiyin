    "企業伺服器的憑證不受這台電腦信任，請公司的管理者協助安裝憑證": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer doesn't trust the enterprise server's certificate. Ask your company's administrator to install it."
