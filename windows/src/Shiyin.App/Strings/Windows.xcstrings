            "value": "Shiyin: opening %@. After you sign in there, come back to Shiyin and click “Check Again”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾音：正在打开 %@。在那里登录之后，回到拾音按“重新检查”。"
          }
        }
      }
    },
    "拾音：處理中": {
      "extractionState": "manual",
