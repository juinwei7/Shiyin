      }
    },
    "錄音中畫面左邊是即時逐字稿，講完幾秒內就會出現；右邊「我的筆記」每換一行會自動記下當時的錄音時間。重要的地方按「標記重點」（Ctrl+B），在其他 app 裡也可以按 Ctrl+Alt+Shift+B。需要中斷時按「暫停」（Ctrl+Shift+P），暫停的時間不會錄進去。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While recording, the live transcript is on the left and appears a few seconds after each sentence; each new line in My notes on the right gets the recording time. Click Mark highlight (Ctrl+B) for important moments, or press Ctrl+Alt+Shift+B in any app. Click Pause (Ctrl+Shift+P) to stop for a while; paused time isn't recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中画面左边是实时逐字稿，讲完几秒内就会出现；右边“我的笔记”每换一行会自动记下当时的录音时间。重要的地方按“标记重点”（Ctrl+B），在其他 app 里也可以按 Ctrl+Alt+Shift+B。需要中断时按“暂停”（Ctrl+Shift+P），暂停的时间不会录进去。"
          }
        }
      }
    },
    "錄音中畫面左邊是即時逐字稿，講完幾秒內就會出現；右邊「我的筆記」每換一行會自動記下當時的錄音時間（錄完在逐字稿分頁頂部的「我的筆記」還能改）。重要的地方按「標記重點」（Ctrl+B），在其他 app 裡也可以按 Ctrl+Alt+Shift+B。需要中斷時按「暫停」（Ctrl+Shift+P），暫停的時間不會錄進去。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While recording, the live transcript appears on the left within seconds of each sentence; My Notes on the right stamps the recording time whenever you start a new line (after recording you can still edit them under My Notes at the top of the Transcript tab). Press Bookmark (Ctrl+B) at important moments, or Ctrl+Alt+Shift+B from any other app. Press Pause (Ctrl+Shift+P) when you need a break; paused time is not recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中画面左边是实时逐字稿，讲完几秒内就会出现；右边“我的笔记”每换一行会自动记下当时的录音时间（录完在逐字稿标签页顶部的“我的笔记”还能改）。重要的地方按“标记重点”（Ctrl+B），在其他 app 里也可以按 Ctrl+Alt+Shift+B。需要中断时按“暂停”（Ctrl+Shift+P），暂停的时间不会录进去。"
          }
        }
      }
    },
    "錄音和轉錄都只在這台電腦上進行，不會上傳。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording and transcription happen only on this PC and are never uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音和转录都只在这台电脑上进行，不会上传。"
          }
        }
      }
    },
    "錄音按鈕旁的箭頭、錄音畫面的麥克風名稱也可以換麥克風。藍牙耳機連著時，Windows 可能自動改用耳機的麥克風，人不在旁邊就錄不到現場的聲音。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also switch microphones from the arrow next to Record or by clicking the microphone name while recording. If a Bluetooth headset is connected, Windows may switch to its microphone, which won't pick up the room if you're not near it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音按钮旁的箭头、录音画面的麦克风名称也可以换麦克风。蓝牙耳机连着时，Windows 可能自动改用耳机的麦克风，人不在旁边就录不到现场的声音。"
          }
        }
      }
    },
    "錄音會送到 %@（公司的伺服器）轉錄，轉完就刪；說話者辨識也在伺服器上做，聲紋只存在這台電腦。會參考詞彙表。連不上時會等，也可以改在這台電腦轉錄。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings are sent to %@ (your company's server) for transcription and deleted afterwards; speakers are identified on the server too, and voiceprints stay on this computer. Uses the glossary. If the server can't be reached, Shiyin waits, or you can transcribe on this computer instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音会送到 %@（公司的服务器）转录，转完就删；说话者识别也在服务器上做，声纹只存在这台电脑。会参考词汇表。连不上时会等，也可以改在这台电脑转录。"
          }
        }
      }
    },
    "開 Zoom、Teams、Google Meet 等線上會議時，拾音會提醒你開始錄音；會議好像結束時提醒停止。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an online meeting starts in Zoom, Teams, Google Meet and so on, Shiyin reminds you to record, and reminds you to stop when it seems to have ended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开 Zoom、Teams、Google Meet 等线上会议时，拾音会提醒你开始录音；会议好像结束时提醒停止。"
          }
        }
      }
    },
    "開始錄音後聽約 10 秒，判斷是哪一種語言（%@）；跟會議語言不同而且有把握時會自動切換，錄音畫面可以改回來。需要 60 MB 的語言偵測模型。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After recording starts, listens for about 10 seconds to tell which language is spoken (%@). If it differs from the meeting language and the result is confident, it switches automatically; you can switch back on the recording screen. Needs the 60 MB language detection model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录音后听约 10 秒，判断是哪一种语言（%@）；跟会议语言不同而且有把握时会自动切换，录音画面可以改回来。需要 60 MB 的语言检测模型。"
          }
        }
      }
    },
    "開始錄音（Ctrl+R），用%@辨識；點右邊的箭頭可以改錄音來源、麥克風和語言": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording (Ctrl+R), recognizing %@; click the arrow on the right to change the source, microphone, and language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录音（Ctrl+R），用%@识别；点右边的箭头可以改录音来源、麦克风和语言"
          }
        }
      }
    },
    "開始錄音（Ctrl+R），用%@辨識；點右邊的箭頭可以改錄音來源和語言": {
      "extractionState": "manual",
