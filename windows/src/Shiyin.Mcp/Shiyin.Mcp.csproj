  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>shiyin-mcp</AssemblyName>
    <RootNamespace>Shiyin.Mcp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shiyin.Services/Shiyin.Services.csproj" />
  </ItemGroup>
</Project>
